[user]
	name = Guillaume Burger
	email = guillaume.burger@wandercraft.health
[core]
    editor = 'nvr' --remote-wait-silent
[alias]
    lg = !"git lgb --all"
    lgg = !"git lgb | less -X"

    lgb = log --graph --abbrev-commit --decorate --format=format:'%C(bold blue)%h%C(reset) - %C(bold yellow)(%ar)%C(reset) %C(auto)%d%C(reset) %C(white)%s%C(reset) -%C(italic magenta) %an%C(reset)'

    rb = rebase
    rbm = rebase upstream/master
    rbv = rebase upstream/calvin_v2_valeo
    rbr = rebase upstream/calvin_v2_renault
    rbma = rebase upstream/master --autostash
    rim = rebase -i upstream/master
    ri = rebase -i
    cm = commit -m
    cma = commit -a -m
    co = checkout
    com = checkout upstream/master
    cov = checkout upstream/calvin_v2_valeo
    cor = checkout upstream/calvin_v2_renault
    sw = switch
    sc = switch -c
    sd = switch -d
    sdm = switch -d upstream/master
    sdv = switch -d upstream/calvin_v2_valeo
    sdr = switch -d upstream/calvin_v2_renault
    cp = cherry-pick
    ft = fetch
    fa = fetch --prune --all
    st = status
    br = branch
    ds = diff --stat
    ca = !"git commit --amend --no-edit"
    cae = commit --amend
    pfo = push -u -f origin
    pfoh = push -u -f origin HEAD
    po = push -u origin
    poh = push -u origin HEAD
    pdo = push --delete origin
    BD = !sh -c 'git branch -D $0 && git push --delete origin $0'
    ap = add --patch
    upm = "upstream/master"
    cleanup-branch = "!git checkout upstream/master && git branch --merged | grep -v -P '^\\*|master|develop' | xargs -n1 -r git branch -d"
    cleanup-remote = !"git checkout upstream/master && git remote prune origin && git branch -r --merged | grep 'origin' | grep -v -P '^\\*|master|develop|HEAD' | sed -r 's/origin\\///g' | xargs -n1 -r git push --delete origin"

    push-ext-branch = !sh -c 'git push $(echo $0 | sed \"s/^EXT_\\(.\\+\\)__\\(.\\+\\)$/git@gitlab.local.wandercraft.eu:wdc\\/software\\/forks\\/\\1\\/wandercode.git \\0:\\2 /\")'
    push-ext-branch-force = !sh -c 'git push --force $(echo $0 | sed \"s/^EXT_\\(.\\+\\)__\\(.\\+\\)$/git@gitlab.local.wandercraft.eu:wdc\\/software\\/forks\\/\\1\\/wandercode.git \\0:\\2 /\")'
    fetch-ext-branch = !sh -c 'git fetch git@gitlab.local.wandercraft.eu:wdc/software/forks/$0/wandercode.git $1 && git checkout -b EXT_$0__$1 FETCH_HEAD'
    pull-ext-branch = !sh -c 'git fetch git@gitlab.local.wandercraft.eu:wdc/software/forks/$0/wandercode.git $1 && git rebase FETCH_HEAD EXT_$0__$1'
    mr = !sh -c 'git fetch upstream merge-requests/$1/head:mr-$1 && git checkout mr-$1' -
[push]
	default = matching
[pager]
	status = true
[pack]
    theads = 1
    deltaCacheSize = 128m
    windowMemory = 50m
