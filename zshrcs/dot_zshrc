    if ! { [ -n "$TMUX" ]; } then
        # Start tmux with vscode socket name to make it totally independant from default tmux (in normal terminal)
        tmux -L vscode && exit
    fi
elif [ "$(basename $(echo $TMUX | cut -f1 -d','))" != "vscode" ]; then
    # Here only if tmux wasn't started with vscode socket name.
    if ! { [ -n "$TMUX" ]; } then
        # tmux attach && exit
        tmux attach
    else
        if ! { [ -n "$NVIM" ]; } then
            source $HOME/global_tools/bin/activate
            nvim -c te -c te -c te -c te -c te -c te -c te -c te -c te -c b1 && exit
        fi
    fi
fi

