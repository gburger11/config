export ZVM_SYSTEM_CLIPBOARD_ENABLED=true
# zsh history search -> Define an init function and append to zvm_after_init_commands to avoid overriding
function my_init() {
    bindkey "^[[A" history-beginning-search-backward
    bindkey "^[OA" history-beginning-search-backward
    bindkey "^[[B" history-beginning-search-forward
    bindkey "^[OB" history-beginning-search-forward
}
zvm_after_init_commands+=(my_init)

# The plugin will auto execute this zvm_after_lazy_keybindings function
function zvm_after_lazy_keybindings() {
  for map in vicmd visual; do
    # Navigation
    zvm_bindkey $map 'c' backward-char
    zvm_bindkey $map 't' history-beginning-search-forward
    zvm_bindkey $map 's' history-beginning-search-backward
    zvm_bindkey $map 'r' forward-char

    # Displaced actions
    zvm_bindkey $map 'j' vi-find-next-char-skip   # was t (jump before char)
    zvm_bindkey $map 'l' vi-substitute             # was s (substitute char)
    zvm_bindkey $map 'h' vi-replace-chars          # was r (replace char)

    # Fix Home/End keys in vi mode
    zvm_bindkey viins '^[[H' beginning-of-line  # Home
    zvm_bindkey viins '^[[F' end-of-line        # End
    zvm_bindkey vicmd '^[[H' beginning-of-line
    zvm_bindkey vicmd '^[[F' end-of-line
  done
}

